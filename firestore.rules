rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone with the link can read and edit the lists (no login, like coffee-fridays)
    match /items/{id} {
      allow read, write: if true;
    }
    // One full-size photo per doc, stored as a JPEG data URL (must fit the 1 MB doc limit)
    match /photos/{id} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.data is string
                            && request.resource.data.data.size() < 1000000;
    }
  }
}
